# Copy to .env and fill in. Never commit .env.

# Neon (dev branch while building): pooled for the app, direct for migrations
DATABASE_URL="postgresql://...-pooler.../neondb?sslmode=require"
DIRECT_URL="postgresql://.../neondb?sslmode=require"

# Google sign-in (Google Cloud → Google Auth Platform → Clients)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
BETTER_AUTH_SECRET=""            # node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_URL="http://localhost:3000"

# AI: Gemini primary, Groq fallback. Model names are optional overrides.
GEMINI_API_KEY=""
GROQ_API_KEY=""
# GEMINI_MODEL_FAST="gemini-3.5-flash"
# GEMINI_MODEL_QUALITY="gemini-3.5-flash"
# GROQ_MODEL="openai/gpt-oss-120b"
# GEMINI_MODEL_FALLBACKS="gemini-flash-lite-latest,gemini-3.5-flash-lite"   # tried when a model's free quota runs out

# People search (Google results). Free key at serper.dev, 2,500 searches, no card.
SERPER_API_KEY=""
# TAVILY_API_KEY=""             # alternative if you prefer Tavily
